{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  <variant-selects
    id='variant-selects-{{ section.id }}'
    data-section='{{ section.id }}'
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      <!-- {{ option | json }} -->
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif
      -%}
      {%- if picker_type == 'swatch' -%}
        <fieldset class='js product-form__input product-form__input--swatch'>
          <legend class='form__label'>
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class='js product-form__input product-form__input--pill'>
          <legend class='form__label'>
            {{ option.name }}
            {% comment %} {% assign engraving_flag = product.metafields.custom.show_engraving_price | strip | downcase %} {% endcomment %}
            {% comment %} Need a safer way of checking if its engraved other than option.name {% endcomment %}
            {% if forloop.last %}
              <span id='engraving-price-placeholder' data-price-usd='100'></span>
            {% endif %}
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- else -%}
        <div class='product-form__input product-form__input--dropdown'>
          <label class='form__label' for='Option-{{ section.id }}-{{ forloop.index0 }}'>
            {{ option.name }}
          </label>
          <div class='select'>
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class='dropdown-swatch'
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id='Option-{{ section.id }}-{{ forloop.index0 }}'
              class='select__select'
              name='options[{{ option.name | escape }}]'
              form='{{ product_form_id }}'
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class='svg-wrapper'>
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type='application/json' data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>

  <fieldset id='engraving-container' class='js product-form__input product-form__input--pill' style='display: none;'>
    <legend class='form__label'></legend>
    <input
      type='text'
      id='engravingText'
      name='properties[Engraving]'
      placeholder='Enter Text (20 Character Limit)'
      maxlength='20'
      minlength='1'
      form='{{ product_form_id }}'
      class='input'
      style='border: 1px solid black; padding: 1rem; width: 100%;'
    >
  </fieldset>

  <script>
    // Map variant IDs to engraving metafield string values
    window.variantEngravingData = {
      {% for variant in product.variants %}
        "{{ variant.id }}": "{{ variant.metafields.custom.show_engraving | default: 'false' }}"{% unless forloop.last %},{% endunless %}
      {% endfor %}
    };

    {% comment %} console.log("Variant engraving data (as strings):", window.variantEngravingData); {% endcomment %}

    function setupEngravingLogic() {
      const engravingContainer = document.getElementById('engraving-container');
      const engravingTextInput = document.getElementById('engravingText');
      const addToCartButton = document.getElementById('ProductSubmitButton-{{ section.id }}');

      if (!engravingContainer || !engravingTextInput || !addToCartButton) return;

      // Get the currently selected variant ID
      function getSelectedVariantId() {
        const selectedVariantJson = document.querySelector('script[data-selected-variant]');
        if (!selectedVariantJson) return null;

        try {
          const variant = JSON.parse(selectedVariantJson.innerText);
          return variant?.id?.toString() || null;
        } catch (e) {
          console.error('Failed to parse selected variant JSON:', e);
          return null;
        }
      }

      function isEngravingMetafieldTrue(variantId) {
        if (!variantId) return false;
        return window.variantEngravingData[variantId] === "true";
      }

      function handleChange() {
        const variantId = getSelectedVariantId();
        const engravingMetafield = isEngravingMetafieldTrue(variantId);

        // Show engraving box only if metafield is "true"
        engravingContainer.style.display = engravingMetafield ? 'flex' : 'none';
        engravingTextInput.disabled = !engravingMetafield;

        // Optional: disable Add to Cart if engraving is required but text empty
        if (engravingMetafield && engravingTextInput.value.trim().length === 0) {
          addToCartButton.disabled = true;
        } else {
          addToCartButton.disabled = false;
        }
      }

      engravingTextInput.addEventListener('input', handleChange);

      // Listen for variant change events (adjust selector as needed)
      const variantSelect = document.getElementById('variant-selects-{{ section.id }}');
      if (variantSelect) {
        variantSelect.addEventListener('change', handleChange);
      }

      handleChange(); // Run once on load
    }

    document.addEventListener('DOMContentLoaded', () => {
      setupEngravingLogic();

      const productSection = document.querySelector('[data-section]');
      if (!productSection) return;

      const observer = new MutationObserver(() => {
        setupEngravingLogic(); // Rebind after any section DOM update
      });

      observer.observe(productSection, {
        childList: true,
        subtree: true,
      });
    });
  </script>

  <script>
    function formatMoney(cents, currency) {
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: currency,
      }).format(cents / 100);
    }

    function keepEngravingPrice() {
      const engravingPrice = document.getElementById('engraving-price-placeholder');
      if (!engravingPrice || engravingPrice.dataset.converted === 'true') return;

      const usdPrice = parseFloat(engravingPrice.dataset.priceUsd);
      const currentCurrency = Shopify.currency?.active || Shopify.currency?.currentCurrency || 'USD';
      const conversionRate = Shopify.currency?.rate || 1;

      const localPrice = Math.round(usdPrice * conversionRate);

      engravingPrice.textContent = `( +${formatMoney(localPrice * 100, currentCurrency)} )`;
      engravingPrice.dataset.converted = 'true'; // Prevent re-conversion
    }

    function observeEngravingPrice(section) {
      const observer = new MutationObserver(() => {
        keepEngravingPrice();
      });

      observer.observe(section, {
        childList: true,
        subtree: true,
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      const section = document.querySelector('[data-section]');
      if (section) {
        keepEngravingPrice();
        observeEngravingPrice(section);
      }
    });
  </script>
{%- endunless -%}
